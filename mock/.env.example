# Gemini API（クライアント側に埋め込まれるため EXPO_PUBLIC_ 必須）
# https://aistudio.google.com/apikey で取得
EXPO_PUBLIC_GEMINI_API_KEY=

# 任意: モデル上書き（省略時 gemini-3.6-flash）
# EXPO_PUBLIC_GEMINI_VISION_MODEL=gemini-3.6-flash
# EXPO_PUBLIC_GEMINI_TEXT_MODEL=gemini-3.6-flash

# 任意: API タイムアウト（ms）。省略時 180000（3分）
# EXPO_PUBLIC_GEMINI_TIMEOUT_MS=180000
